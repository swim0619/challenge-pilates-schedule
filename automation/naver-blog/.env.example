# ── 필수 ────────────────────────────────────────────────
# 글 작성용 Claude API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# 사용할 모델 (기본값: claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# ── 네이버 블로그 ───────────────────────────────────────
# 내 블로그 아이디 (blog.naver.com/<여기>). 비워두면 로그인 세션에서 자동 감지 시도.
NAVER_BLOG_ID=
# 크롬 원격 디버깅 포트 (chrome.sh 와 반드시 같은 값)
CHROME_CDP_PORT=9222

# ── 글감 수집 (선택) ────────────────────────────────────
# 네이버 개발자센터 애플리케이션 키. 없으면 크롬으로 검색결과를 직접 읽어옵니다.
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 이미지 (선택) ───────────────────────────────────────
# Pexels 무료 스톡 사진 API 키 (https://www.pexels.com/api/)
# 없으면 images/ 폴더의 내 사진 → 위키미디어 공용(CC) 순으로 사용합니다.
PEXELS_API_KEY=

# ── Supabase 연동 (선택) ────────────────────────────────
# 값을 채우면 생성된 초안을 blog_drafts 테이블에도 저장합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
